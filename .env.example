# Neon Auth (managed Better Auth). Server-side Next.js integration.
NEON_AUTH_BASE_URL=https://ep-red-salad-bbgjigfc.neonauth.c-15.us-east-1.aws.neon.tech/neondb/auth
# Generate with: openssl rand -hex 32. Keep the same secret across a deployment.
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# PostgreSQL content storage. Never expose credentials through VITE_ variables.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
SEED_PROJECT_SLUG=jazboom
# Initial owner's Neon Auth user ID, shown on the pending-access/account page.
# Set this before db:setup to grant the owner membership in the seeded project.
# ADMIN_PROJECT_OWNER_SUB=NEON_USER_ID
# Optional comma-separated Neon user IDs allowed to create new projects.
# ADMIN_USER_IDS=NEON_USER_ID
# Optional custom admin origin. Trusted Vercel hosts are detected automatically.
# APP_BASE_URL=http://localhost:3000
