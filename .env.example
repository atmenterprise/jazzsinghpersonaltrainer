# Backend only. Never expose DATABASE_URL to the browser. Node.js 22+ recommended.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
API_PORT=3001
AUTH0_DOMAIN=your-tenant.uk.auth0.com
AUTH0_AUDIENCE=https://atm-content-studio-api

# Public Auth0 SPA configuration (these are identifiers, not secrets).
# Domain and audience must match the backend values above.
VITE_AUTH0_DOMAIN=your-tenant.uk.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://atm-content-studio-api

# Optional initial import project. Defaults come from the existing website data.
SEED_PROJECT_SLUG=jazboom
# Auth0 user ID of the initial imported-project owner (not an email).
ADMIN_PROJECT_OWNER_SUB=auth0|YOUR_USER_ID
