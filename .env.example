# Server only: the Auth0 Regular Web Application variables supplied by Vercel.
AUTH0_CLIENT_ID=YOUR_REGULAR_WEB_APPLICATION_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_REGULAR_WEB_APPLICATION_CLIENT_SECRET
AUTH0_DOMAIN=your-tenant.uk.auth0.com
# Use a cryptographically random secret of at least 32 characters.
# Generate locally with: openssl rand -hex 32
AUTH0_SECRET=REPLACE_WITH_A_RANDOM_SESSION_ENCRYPTION_SECRET

# Server-only credentials for an application authorized for Auth0 Management API
# read:users. Used to check the signed-in user's manage:content permission.
AUTH0_MANAGEMENT_API_CLIENT_ID=YOUR_MANAGEMENT_API_CLIENT_ID
AUTH0_MANAGEMENT_API_CLIENT_SECRET=YOUR_MANAGEMENT_API_CLIENT_SECRET

# Optional: custom content API identifier; defaults to this value when checking
# permissions through the Management API. Set only if requesting API tokens too.
# AUTH0_AUDIENCE=https://atm-content-studio-api
# Optional for custom hosts. Local defaults to http://localhost:5173;
# Vercel hosts are detected from trusted Vercel system environment variables.
# AUTH0_BASE_URL=http://localhost:5173

# PostgreSQL content storage. Never expose any of these secrets through VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
API_PORT=3001
SEED_PROJECT_SLUG=jazboom
ADMIN_PROJECT_OWNER_SUB=auth0|YOUR_USER_ID
