{
  "name": "jazzsinghpersonaltrainer",
  "version": "1.0.0",
  "description": "Personal Trainer Website of Jaz Singh, Ilford, UK. React conversion.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:site && next dev --webpack",
    "build": "npm run build:site && next build --webpack",
    "preview": "next start",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test:admin": "node --test tests/admin.test.js tests/auth.test.js tests/projects.test.js tests/session-auth.test.js tests/next-api.test.js",
    "dev:site": "vite",
    "build:site": "vite build --mode next-public --outDir public/site --emptyOutDir",
    "build:static": "vite build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-next.mjs"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
